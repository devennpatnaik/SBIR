FROM oven/bun:1.4.3-alpine AS build
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --minimum-release-age=0 --frozen-lockfile || bun install --minimum-release-age=0
ARG VITE_API_BASE_URL=/api
ARG VITE_AUTH_MODE=local
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AUTH_MODE=$VITE_AUTH_MODE
# Compatibility aliases (old Bourne/Neon names unused when AUTH_MODE=local)
ENV VITE_BOURNE_BACKEND_URL=$VITE_API_BASE_URL
ENV VITE_NEON_AUTH_BASE_URL=
WORKDIR /app/apps/untitled-app-6ac856247b02af3fede23b91
RUN bun run build

FROM nginx:1.27-alpine
COPY deploy/selfhost/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/untitled-app-6ac856247b02af3fede23b91/dist /usr/share/nginx/html
EXPOSE 80
