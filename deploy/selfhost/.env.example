# Copy to deploy/selfhost/.env before compose up.
# Never commit real secrets.

POSTGRES_USER=ltm
POSTGRES_PASSWORD=labtomarket
POSTGRES_DB=labtomarket
POSTGRES_PORT=5432
POSTGREST_PORT=3001
API_PORT=8787
WEB_PORT=8080

# REQUIRED for local auth — use a long random string (≥32 chars). Never ship the default.
JWT_SECRET=dev-change-me-use-at-least-32-chars!!

# Language model (set one). Prefer OpenAI when both are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Set to 1 only for offline demos without a key (never in real prod).
ASSISTANT_DEV_FALLBACK=0

# production | development — production refuses placeholder JWT_SECRET
NODE_ENV=development
