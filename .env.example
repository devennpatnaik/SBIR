# Lab to Market — Docker Compose (Bourne-free)
# Copy next to docker-compose.yml:
#   cp deploy/selfhost/.env.example deploy/selfhost/.env
# Or from this export folder after extracting the tarball:
#   cp .env.example lab-to-market-source/deploy/selfhost/.env

POSTGRES_USER=ltm
POSTGRES_PASSWORD=labtomarket
POSTGRES_DB=labtomarket
POSTGRES_PORT=5432
POSTGREST_PORT=3001
API_PORT=8787
WEB_PORT=8080

# HS256 secret shared by API + PostgREST (use a long random string beyond local play)
JWT_SECRET=dev-change-me-use-at-least-32-chars!!

# --- Optional: non-Compose / legacy hosted path (not required for self-host) ---
# VITE_API_BASE_URL=http://localhost:8787
# VITE_AUTH_MODE=local
# AUTH_MODE=local
# DATABASE_URL=postgres://ltm:labtomarket@localhost:5432/labtomarket
# NEON_DATA_API_URL=http://localhost:3001
