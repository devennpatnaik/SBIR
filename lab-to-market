#!/usr/bin/env bash
# One-command Lab to Market (Docker Compose).
# Usage:
#   ./lab-to-market            # up --build (detached)
#   ./lab-to-market up         # same
#   ./lab-to-market down
#   ./lab-to-market logs
#   ./lab-to-market prod       # prod-like overlay
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_DIR="$ROOT/deploy/selfhost"
cd "$COMPOSE_DIR"

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created deploy/selfhost/.env from .env.example — set JWT_SECRET (and an LLM key) before sharing."
fi

cmd="${1:-up}"
shift || true

case "$cmd" in
  up|start)
    docker compose up -d --build "$@"
    echo ""
    echo "Lab to Market → http://localhost:${WEB_PORT:-8080}"
    echo "API health     → http://localhost:${API_PORT:-8787}/health"
    ;;
  prod)
    docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build "$@"
    echo "Prod-like stack is up. Put TLS/reverse-proxy in front of the web port."
    ;;
  down|stop)
    docker compose down "$@"
    ;;
  logs)
    docker compose logs -f "$@"
    ;;
  ps|status)
    docker compose ps
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Usage: ./lab-to-market [up|prod|down|logs|ps]" >&2
    exit 1
    ;;
esac
